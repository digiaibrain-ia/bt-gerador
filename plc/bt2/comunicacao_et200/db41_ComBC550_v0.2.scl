DATA_BLOCK "ComBC550"
TITLE = ComBC550 v0.2 (DB41)
{ S7_Optimized_Access := 'FALSE' }
AUTHOR : 'RegLobo'
VERSION : 0.2
NON_RETAIN
////====================================
//// ComBC550 (DB41) - programa "Gerador_BC015"
//// VERSAO    : 0.1 (03/11/2026) - RASCUNHO, nao compilado. Mesmo layout do DB38/DB39 (6+6 bytes, ate 16 chaves) para o BC550 (12 chaves). Numero 41 = sugestao; confirmar no TIA do ET200.
////             AUTHOR aceita no maximo 8 caracteres. A versao fica AQUI porque o nome do bloco no TIA nao leva versao.
//// O QUE FAZ : area de troca PUT/GET com o 1515 para o banco BC550 (12 bytes), layout igual ao DB38.
//// POR QUE DB GLOBAL SEM OTIMIZACAO : PUT/GET enderecam por byte/bit absoluto.
//// ESCRITOR UNICO : DBB0..5 so pelo PUT do 1515; DBB6..11 so pelo FC4 do ET200.
//// RELACAO COM OUTROS DBs : par do db3305i_BC550_ComEt200 no 1515 (instancia do FB101).
//// Autor: RegLobo  -  Versao: 0.2  -  Projeto: NOde-red (BT2)
////=====================================
   STRUCT
      cmd : Array[1..16] of Bool;   // DBX0.0..1.7 comando das contatoras (PUT do 1515)
      vida1515 : Int;   // DBW2 contador de vida do 1515, 0 a 32766 (PUT)
      ligarBanco : Bool;   // DBX4.0 comando Ligar banco (PUT)
      resPut : Byte;
      fbk : Array[1..16] of Bool;   // DBX6.0..7.7 contato auxiliar de cada contatora (GET)
      vidaET : Int;   // DBW8 contador de vida do ET200 (GET)
      seletoraAuto : Bool;   // DBX10.0 seletora do banco em Auto/remoto, 1 = Auto (GET)
      resGet : Byte;
   END_STRUCT;
BEGIN
END_DATA_BLOCK
