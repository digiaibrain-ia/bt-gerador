FUNCTION_BLOCK "fb101_ComCarga"
TITLE = fb101_ComCarga v0.9 (FB101)
{ S7_Optimized_Access := 'FALSE' }
AUTHOR : 'Reginaldo Lobo'
VERSION : 0.9
////====================================
//// fb101_ComCarga (FB101) v0.9 (10/11/2026) - RASCUNHO, nao compilado, nao testado no PLC. Lado do 1515 (S7-1500) para o PLC de CARGA (S7-1214FC).
////   = fb101_ComEt200 v0.8 com o nome e os comentarios trocados para o PLC de Carga. A LOGICA E IDENTICA (conferido por script: o codigo da v0.8 e da v0.9 sao iguais depois de trocar o nome).
//// O QUE FAZ : troca de sinais 1515 <-> PLC de Carga por S7 PUT/GET, um banco por instancia: PUT 10 bytes (PEDIDO: cmd[16], vida do 1515, ligarBanco, habPed[16], seq)
////             e GET 14 bytes (RESPOSTA: fbk[16], vida do PLC de Carga, seletoraAuto, habResp[16], eco, falhaRetorno[16], contatorColado[16]).
////             Habilitar/desabilitar com confirmacao (habPed/habResp), seq/eco (RespEcoOk) e regra "SB some -> CB cai" (o PLC de Carga trava a falha; este FB zera o CbLigar da chave).
//// REMOTO    : BC56 = DB3007; BC400 = DB3107 no PLC de Carga (tipo ComBanco, 24 bytes, sem acesso otimizado). PUT P#DB3007.DBX0.0 BYTE 10 / GET P#DB3007.DBX10.0 BYTE 14.
////             O PLC de Carga precisa do fb_bancoCarga16 + db_ComBancos (entrega 1200) e os DBs db3000/db3100 v0.3 (com sbRet) no 1515. Carregar os dois PLCs na mesma janela.
//// INSTANCIAS: db3005i_BC56_ComCarga (DB3005) e db3105i_BC400_ComCarga (DB3105). ID_Conexao: a PREENCHER (ID da conexao S7 criada no TIA para o PLC de Carga).
//// COMO OPERA: chamar 1x por ciclo no OB ciclico, ANTES do fb100_setupChaves. IN_OUT: CbLigar[] escrito pelo FB100/Node-RED e ZERADO por este FB quando o banco nao esta liberado;
////             LigarBanco escrito pelo Node-RED e ZERADO por este FB se a seletora sai de Auto ou a comunicacao cai; SbLigada[] escrito so por este FB.
//// FALHA     : sem vida nova do PLC de Carga por TempoVida (3 s) -> ComOk=FALSE, SbLigada[] zerado, SeletoraAuto=FALSE, LigarBanco e CbLigar[] zerados (sem religamento automatico).
//// HISTORICO : v0.8 (06/11/2026) pedido/resposta e SB some -> CB cai; v0.9: so nome e comentarios (PLC de Carga em vez do ET200). O nome do bloco no TIA nao leva versao: a versao fica aqui.
////=====================================
   VAR_INPUT
      Hab : Bool;   // TRUE = comunica; FALSE = para e vai para estado seguro
      ID_Conexao : Word;   // ID local da conexao S7 do 1515 com o PLC de Carga (a PREENCHER no TIA; o mesmo para os 2 bancos)
      RemotoCmd : Remote;   // remoto PEDIDO (cmd+vida+ligarBanco+habPed+seq). BC56: P#DB3007.DBX0.0 BYTE 10
      RemotoFb : Remote;   // remoto RESPOSTA (fbk+vida+seletora+habResp+eco+falhas). BC56: P#DB3007.DBX10.0 BYTE 14
      TempoVida : Time := T#3S;   // sem vida nova do PLC de Carga por este tempo = comunicacao perdida
      Pausa : Time := T#100MS;   // pausa entre ciclos PUT/GET
      CiclosGraca : Int := 3;   // v0.8: ciclos PUT/GET que o PLC de Carga tem para tratar um NOVO comando numa chave com falha travada (rearme)
   END_VAR

   VAR_OUTPUT
      ComOk : Bool;   // TRUE = PLC de Carga respondendo e vida mudando (ligar em sbBanco.comEt200Ok)
      SeletoraAuto : Bool;   // TRUE = seletora do banco em Auto e ComOk (ligar em sbBanco.seletoraAuto)
      StatusPut : Word;   // ultimo STATUS do PUT (0 = ok)
      StatusGet : Word;   // ultimo STATUS do GET (0 = ok)
      FalhaPut : Bool;   // ultimo PUT terminou com ERROR
      FalhaGet : Bool;   // ultimo GET terminou com ERROR
      RespEcoOk : Bool;   // v0.8: o eco do PLC de Carga acompanha o seq enviado (resposta fresca; base da confirmacao de habilitar)
   END_VAR

   VAR_IN_OUT
      CbLigar : Array[1..16] of Bool;   // <db banco>.cb.ligar - FB100/Node-RED escrevem, este FB le e zera
      SbLigada : Array[1..16] of Bool;   // <db banco>.sb.ligada - escrito so por este FB
      LigarBanco : Bool;   // <db banco>.cbBanco.ligar - Node-RED escreve, este FB le e zera
      HabilitadaPed : Array[1..16] of Bool;   // v0.8 <db banco>.setup.habilitada - Node-RED escreve; este FB so le e envia como pedido
      HabResp : Array[1..16] of Bool;   // v0.8 <db banco>.sbRet.habResp - resposta do PLC de Carga (so com ComOk e RespEcoOk)
      FalhaRetorno : Array[1..16] of Bool;   // v0.8 <db banco>.sbRet.falhaRetorno - travada no PLC de Carga ate novo comando
      ContatorColado : Array[1..16] of Bool;   // v0.8 <db banco>.sbRet.contatorColado - travado no PLC de Carga ate novo comando
   END_VAR

   VAR
      statPut : PUT;   // multi-instancia do PUT
      statGet : GET;   // multi-instancia do GET
      tx : Struct   // 1515 -> PLC de Carga, 10 bytes (PEDIDO)
         cmd : Array[1..16] of Bool;   // DBX0.0..1.7 remoto
         vida : Int;   // DBW2 remoto
         ligarBanco : Bool;   // DBX4.0 remoto
         reserva : Byte;
         habPed : Array[1..16] of Bool;   // DBX6.0..7.7 remoto (v0.8)
         seq : Int;   // DBW8 remoto (v0.8)
      END_STRUCT;
      rx : Struct   // PLC de Carga -> 1515, 14 bytes (RESPOSTA)
         fbk : Array[1..16] of Bool;   // DBX10.0..11.7 remoto ("fb" e palavra reservada)
         vida : Int;   // DBW12 remoto
         seletoraAuto : Bool;   // DBX14.0 remoto
         reserva : Byte;
         habResp : Array[1..16] of Bool;   // DBX16.0..17.7 remoto (v0.8)
         eco : Int;   // DBW18 remoto (v0.8)
         falhaRetorno : Array[1..16] of Bool;   // DBX20.0..21.7 remoto (v0.8)
         contatorColado : Array[1..16] of Bool;   // DBX22.0..23.7 remoto (v0.8)
      END_STRUCT;
      estado : Int;   // 0 inicia PUT, 1 aguarda PUT, 2 inicia GET, 3 aguarda GET, 4 pausa
      reqPut : Bool;
      reqGet : Bool;
      putDone : Bool;
      putError : Bool;
      getNdr : Bool;
      getError : Bool;
      vidaAnt : Int;   // ultima vida do PLC de Carga vista
      seqUlt : Int;   // v0.8: ultimo seq enviado no PUT
      cGraca : Array[1..16] of Int;   // v0.8: ciclos com comando ligado numa chave com falha travada
      ecoOk : Bool;   // v0.8: eco = seq ou seq-1 (o PLC de Carga trata o pacote entre o PUT e o GET)
      vidaMudou : Bool;   // vida do PLC de Carga mudou neste ciclo
      jaLeu : Bool;   // TRUE apos o 1o GET bem-sucedido
      tPausa : TON_TIME;
      tVida : TON_TIME;
      i : Int;
   END_VAR

BEGIN

   REGION "0) Intertravamento do banco (seguranca no PLC)"
      // Executa todo ciclo, ANTES de montar o telegrama, com ComOk e rx do ciclo anterior.
      // Banco liberado = comunicacao viva (ComOk) E seletora em Auto E LigarBanco = TRUE.
      // Seletora fora de Auto ou comunicacao perdida: zera LigarBanco. O operador precisa
      // comandar "Ligar banco" de novo; nada religa sozinho quando a comunicacao volta.
      // Banco desligado: zera CbLigar[] (inclui a chave do Setup acionada pelo FB100), entao
      // nenhuma chave e enviada ao PLC de Carga nem fica "lembrada" para ligar depois.
      // Bloqueio visivel no TIA: LigarBanco volta a FALSE sozinho = seletora/ComOk.
      #SeletoraAuto := #ComOk AND #rx.seletoraAuto;
      IF NOT #SeletoraAuto THEN
         #LigarBanco := FALSE;
      END_IF;
      IF NOT #LigarBanco THEN
         FOR #i := 1 TO 16 DO
            #CbLigar[#i] := FALSE;
         END_FOR;
      END_IF;
      // v0.8: regra "SB some -> CB cai". O PLC de Carga travou falha de retorno / contator colado nesta chave: o CB dela cai no 1515.
      // A falha continua visivel (FalhaRetorno/ContatorColado) ate o operador mandar novo comando; nada rearma sozinho.
      // POR QUE COM TEMPO (CiclosGraca): o rearme acontece no PLC de Carga na BORDA DE SUBIDA do comando. Se o 1515 zerasse o CB no mesmo
      // instante, o PLC de Carga nunca veria a borda e a chave ficaria travada para sempre. Entao um comando novo vale por CiclosGraca ciclos de PUT/GET;
      // se a falha NAO limpar nesse prazo (ex.: contator colado), o CB cai de novo. A saida no PLC de Carga ja esta bloqueada desde o primeiro instante.
      FOR #i := 1 TO 16 DO
         IF #cGraca[#i] >= #CiclosGraca THEN
            #CbLigar[#i] := FALSE;
         END_IF;
      END_FOR;
   END_REGION

   REGION "1) Chamada das instrucoes PUT e GET"
      // As instrucoes sao chamadas TODO ciclo; quem dispara e o REQ da maquina de estados.
      // PUT envia tx (6 bytes) para RemotoCmd; GET le RemotoFb (6 bytes) para rx.
      // O comprimento em RemotoCmd/RemotoFb tem que ser BYTE 6, igual ao tamanho de tx/rx;
      // diferenca de tamanho gera ERROR com STATUS de parametrizacao (ver StatusPut/StatusGet).
      // Limite da instrucao (~212 bytes por chamada) esta muito acima do usado aqui.
      #statPut(REQ := #reqPut,
               ID := #ID_Conexao,
               DONE => #putDone,
               ERROR => #putError,
               STATUS => #StatusPut,
               ADDR_1 := #RemotoCmd,
               SD_1 := #tx);
      #statGet(REQ := #reqGet,
               ID := #ID_Conexao,
               NDR => #getNdr,
               ERROR => #getError,
               STATUS => #StatusGet,
               ADDR_1 := #RemotoFb,
               RD_1 := #rx);
   END_REGION

   REGION "2) Maquina de estados PUT -> GET -> pausa"
      // Um job por vez na conexao (os 2 bancos dividem o mesmo ID_Conexao).
      // Estado 0: copia CbLigar[] e LigarBanco (ja intertravados na REGION 0) para tx,
      //           incrementa a vida do 1515 e dispara o PUT.
      // Estado 1: aguarda DONE ou ERROR do PUT; ERROR fica em FalhaPut.
      // Estado 2: dispara o GET.
      // Estado 3: aguarda NDR ou ERROR do GET; com NDR marca jaLeu e detecta vida nova do PLC de Carga.
      // Estado 4: pausa (Pausa) e volta ao estado 0.
      // Hab = FALSE: volta ao estado 0 sem REQ, e jaLeu = FALSE derruba ComOk.
      #vidaMudou := FALSE;
      IF NOT #Hab THEN
         #estado := 0;
         #reqPut := FALSE;
         #reqGet := FALSE;
         #jaLeu := FALSE;
      ELSE
         CASE #estado OF
            0:
               FOR #i := 1 TO 16 DO
                  #tx.cmd[#i] := #CbLigar[#i];
               END_FOR;
               #tx.ligarBanco := #LigarBanco;
               FOR #i := 1 TO 16 DO
                  #tx.habPed[#i] := #HabilitadaPed[#i];   // v0.8: pedido de habilitar/desabilitar
                  IF (#FalhaRetorno[#i] OR #ContatorColado[#i]) AND #CbLigar[#i] THEN   // v0.8: conta ciclos com comando numa chave em falha
                     IF #cGraca[#i] < 32000 THEN #cGraca[#i] := #cGraca[#i] + 1; END_IF;
                  ELSE
                     #cGraca[#i] := 0;
                  END_IF;
               END_FOR;
               #tx.seq := #tx.seq + 1;                     // v0.8: contador do pacote (1..32766)
               IF #tx.seq >= 32767 OR #tx.seq < 1 THEN
                  #tx.seq := 1;
               END_IF;
               #seqUlt := #tx.seq;
               #tx.vida := #tx.vida + 1;
               IF #tx.vida >= 32767 THEN
                  #tx.vida := 0;
               END_IF;
               #reqPut := TRUE;
               #estado := 1;
            1:
               IF #putDone OR #putError THEN
                  #FalhaPut := #putError;
                  #reqPut := FALSE;
                  #estado := 2;
               END_IF;
            2:
               #reqGet := TRUE;
               #estado := 3;
            3:
               IF #getNdr OR #getError THEN
                  #FalhaGet := #getError;
                  IF #getNdr THEN
                     #jaLeu := TRUE;
                     IF #rx.vida <> #vidaAnt THEN
                        #vidaAnt := #rx.vida;
                        #vidaMudou := TRUE;
                     END_IF;
                  END_IF;
                  #reqGet := FALSE;
                  #estado := 4;
               END_IF;
            4:
               IF #tPausa.Q THEN
                  #estado := 0;
               END_IF;
            ELSE
               #estado := 0;
         END_CASE;
      END_IF;
   END_REGION

   REGION "3) Temporizadores de pausa e de vida"
      // tPausa conta so no estado 4 e libera o proximo ciclo PUT/GET.
      // tVida conta enquanto a vida do PLC de Carga NAO muda; qualquer vida nova reinicia a contagem.
      // tVida.Q = TRUE significa PLC de Carga parado, cabo/rede fora ou conexao S7 nao estabelecida.
      // Os dois temporizadores sao chamados todo ciclo (regra do TON).
      // Com Hab = FALSE os dois ficam resetados.
      #tPausa(IN := #Hab AND (#estado = 4), PT := #Pausa);
      #tVida(IN := #Hab AND NOT #vidaMudou, PT := #TempoVida);
   END_REGION

   REGION "4) Saidas: comunicacao, feedback e seletora"
      // ComOk exige Hab, ao menos um GET bem-sucedido e vida do PLC de Carga mudando.
      // Com ComOk: SbLigada[] recebe o feedback real das contatoras (rx.fbk).
      // Sem ComOk: SbLigada[] zerado (o PLC de Carga ja derrubou as saidas pela vida parada).
      // SeletoraAuto e recalculada aqui para a tela/Node-RED verem o valor deste ciclo;
      // o intertravamento da REGION 0 usa esse valor no proximo ciclo.
      #ComOk := #Hab AND #jaLeu AND NOT #tVida.Q;
      #SeletoraAuto := #ComOk AND #rx.seletoraAuto;
      // v0.8: resposta fresca = eco igual ao seq enviado ou ao anterior (com wrap em 1..32766)
      #ecoOk := (#rx.eco = #seqUlt) OR (#rx.eco = #seqUlt - 1) OR (#seqUlt = 1 AND #rx.eco = 32766);
      #RespEcoOk := #ComOk AND #ecoOk;
      IF #ComOk THEN
         FOR #i := 1 TO 16 DO
            #SbLigada[#i] := #rx.fbk[#i];
            #HabResp[#i] := #rx.habResp[#i] AND #ecoOk;    // sem eco fresco a habilitacao NAO e confirmada
            #FalhaRetorno[#i] := #rx.falhaRetorno[#i];
            #ContatorColado[#i] := #rx.contatorColado[#i];
         END_FOR;
      ELSE
         // sem comunicacao: nada confirmado; as falhas ficam como estavam (travadas) e o PLC de Carga zera na partida da CPU
         FOR #i := 1 TO 16 DO
            #SbLigada[#i] := FALSE;
            #HabResp[#i] := FALSE;
         END_FOR;
      END_IF;
   END_REGION

END_FUNCTION_BLOCK
