//// db3008_BC56_Competencia (DB3008) v0.1 (09/11/2026) - RASCUNHO, NAO compilado no TIA, NAO testado no PLC. Faz parte do pacote plc_carga_1200 (S7-1200 real).
//// O QUE FAZ : DB DE COMPETENCIA de BC56 (sinais do banco para o 1515). NUMERO PROPOSTO (base 3000 + 8), mesmo no 1515. GET do 1515: P#DB3008.DBX0.0 BYTE 8.
////====================================
   VAR
      compet : "typeCompetenciaBanco";
   END_VAR
BEGIN
END_DATA_BLOCK

DATA_BLOCK "db3000_BC56_Chaves"
TITLE = db3000_BC56_Chaves v0.1 (DB3000) ESPELHO
{ S7_Optimized_Access := 'FALSE' }
AUTHOR : 'RegLobo'
VERSION : 0.1
NON_RETAIN
////====================================
//// db3000_BC56_Chaves (DB3000) ESPELHO v0.1 (09/11/2026) - RASCUNHO, NAO compilado no TIA, NAO testado no PLC. Faz parte do pacote plc_carga_1200 (S7-1200 real).
//// O QUE FAZ : COPIA DE MAO UNICA do DB de chaves do 1515 (mesmo numero e MESMOS offsets), so para a IHM/Runtime deste PLC. NAO e usada para controle.
////   bytes 0..3  (cb, sb): preenchidos AQUI pelo fc_chamadasBancosCarga a partir do DB3007 (comando e feedback ao vivo).
////   bytes 4..199 (habilitada, setupOk, kwReal, rMedidoOhm, rTeoricoOhm = 196 B): escritos pelo PUT do 1515 numa passada (P#DB3000.DBX4.0 BYTE 196, limite do PUT/GET ~212 B).
////   Os demais campos do DB do 1515 (setupData, nominal, chaveSel, ...) NAO sao espelhados. Escritor unico por faixa. CONFERIR os deslocamentos no TIA.
////====================================
   VAR
      cb : Struct
         ligar : Array[1..16] of Bool;   // X0.0
      END_STRUCT;
      sb : Struct
         ligada : Array[1..16] of Bool;   // X2.0
      END_STRUCT;
      setup : Struct
         habilitada : Array[1..16] of Bool;    // X4.0  (PUT 1515)
         setupOk : Array[1..16] of Bool;       // X6.0  (PUT 1515)
         kwReal : Array[1..16] of Real;        // D8    (PUT 1515)
         rMedidoOhm : Array[1..16] of Real;    // D72   (PUT 1515)
         rTeoricoOhm : Array[1..16] of Real;   // D136  (PUT 1515)
      END_STRUCT;
   END_VAR
BEGIN
END_DATA_BLOCK

