    kWNominal := "db3100_BC400_Chaves".setup.nominal, CbLigar := "db3100_BC400_Chaves".cb.ligar, SbLigada := "db3100_BC400_Chaves".sb.ligada, Habilitada := "db3100_BC400_Chaves".setup.habilitada,
    SetupOk := "db3100_BC400_Chaves".setup.setupOk, KwReal := "db3100_BC400_Chaves".setup.kwReal, RmedidoOhm := "db3100_BC400_Chaves".setup.rMedidoOhm,
