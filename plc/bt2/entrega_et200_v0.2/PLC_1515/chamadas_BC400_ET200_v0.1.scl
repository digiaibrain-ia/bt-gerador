// "db2000_BancoTeste2_DSE" = o antigo db52 renumerado (plano de numeracao v7.1): CONFERIR o nome do DB e os campos ledManual, potenciaKw, tensaoL1L2/L2L3/L3L1 no TIA.
// Campo "comEt200Ok" do DB de chaves: nome mantido (so simbolico; renomear quebraria as referencias do FC100/card); significa "comunicacao com o ET200 ok".
"db3105i_BC400_ComEt200"(Hab := TRUE, ID_Conexao := W#16#0,   /* A PREENCHER: ID da conexao S7 com o ET200 */
    RemotoCmd := P#DB39.DBX0.0 BYTE 10, RemotoFb := P#DB39.DBX10.0 BYTE 14,   // v0.8: PEDIDO 10 B / RESPOSTA 14 B
