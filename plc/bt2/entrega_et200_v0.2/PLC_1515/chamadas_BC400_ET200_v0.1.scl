    BaseKwV := "db3102_BC400_SetupPorTensao".setupV.baseKw, SetupDataV := "db3102_BC400_SetupPorTensao".setupV.setupData, SetupOkV := "db3102_BC400_SetupPorTensao".setupV.setupOk);
