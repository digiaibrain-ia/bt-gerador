    HabilitadaPed := "db3100_BC400_Chaves".setup.habilitada, HabResp := "db3100_BC400_Chaves".sbRet.habResp,
    FalhaRetorno := "db3100_BC400_Chaves".sbRet.falhaRetorno, ContatorColado := "db3100_BC400_Chaves".sbRet.contatorColado);

