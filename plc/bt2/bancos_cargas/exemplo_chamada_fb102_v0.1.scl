    VaMedido         := "db52_BancoTeste2_DSE".tensaoL1L2,
    VbMedido         := "db52_BancoTeste2_DSE".tensaoL2L3,
    VcMedido         := "db52_BancoTeste2_DSE".tensaoL3L1,
    TensaoSel        := "db3302_BC550_SetupPorTensao".selV.tensaoSel,
    ChaveSelecionada := "db3300_BC550_Chaves".setup.chaveSel,
    ComandoSalvar    := "db3300_BC550_Chaves".setup.salvar,
    kWNominal        := "db3300_BC550_Chaves".setup.nominal,
    CbLigar          := "db3300_BC550_Chaves".cb.ligar,
    SbLigada         := "db3300_BC550_Chaves".sb.ligada,
    Habilitada       := "db3300_BC550_Chaves".setup.habilitada,
