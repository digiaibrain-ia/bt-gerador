// ============================================================================
// EXEMPLO de chamada do fb102_setupChaves32 (FB102) - RASCUNHO v0.1 (03/11/2026), nao compilado
// 1 chamada por banco novo, DEPOIS das chamadas do FB103 (comunicacao) e das do FB100 (BC56/BC400).
// Instancia = DB do banco + 4 (db3204 / db3304), conforme PLANO_NUMERACAO_BLOCOS_PLC_v5_exemplo.xlsx.
// BC59,5: NumChaves 18 (BLOQUEIO anterior de 16 posicoes resolvido pelo FB102 de 32).
// ============================================================================

// --- Banco BC59,5 (18 chaves) ---
"fb102_setupChaves32"_DB3204(
    NumChaves        := 18,
    GeradorOperando  := "db52_BancoTeste2_DSE".ledManual,
    EnsaioAtivo      := FALSE,   // TODO: tag real do DB "Dados do ensaio"
    kWMedido         := "db52_BancoTeste2_DSE".potenciaKw,
    VaMedido         := "db52_BancoTeste2_DSE".tensaoL1L2,
    VbMedido         := "db52_BancoTeste2_DSE".tensaoL2L3,
    VcMedido         := "db52_BancoTeste2_DSE".tensaoL3L1,
    TensaoSel        := "db3202_BC595_SetupPorTensao".selV.tensaoSel,
    ChaveSelecionada := "db3200_BC595_Chaves".setup.chaveSel,
    ComandoSalvar    := "db3200_BC595_Chaves".setup.salvar,
    kWNominal        := "db3200_BC595_Chaves".setup.nominal,
    CbLigar          := "db3200_BC595_Chaves".cb.ligar,
    SbLigada         := "db3200_BC595_Chaves".sb.ligada,
    Habilitada       := "db3200_BC595_Chaves".setup.habilitada,
    SetupOk          := "db3200_BC595_Chaves".setup.setupOk,
    KwReal           := "db3200_BC595_Chaves".setup.kwReal,
    RmedidoOhm       := "db3200_BC595_Chaves".setup.rMedidoOhm,
    RteoricoOhm      := "db3200_BC595_Chaves".setup.rTeoricoOhm,
    SetupData        := "db3200_BC595_Chaves".setup.setupData,
    KwRealV          := "db3202_BC595_SetupPorTensao".setupV.kwReal,
    RmedidoV         := "db3202_BC595_SetupPorTensao".setupV.rMedidoOhm,
    VmedidaV         := "db3202_BC595_SetupPorTensao".setupV.vMedidaV,
    BaseKwV          := "db3202_BC595_SetupPorTensao".setupV.baseKw,
    SetupDataV       := "db3202_BC595_SetupPorTensao".setupV.setupData,
    SetupOkV         := "db3202_BC595_SetupPorTensao".setupV.setupOk);

// --- Banco BC550 (12 chaves) ---
