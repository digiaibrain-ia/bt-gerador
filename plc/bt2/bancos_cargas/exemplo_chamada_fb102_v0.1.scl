    RmedidoOhm       := "db3300_BC550_Chaves".setup.rMedidoOhm,
    RteoricoOhm      := "db3300_BC550_Chaves".setup.rTeoricoOhm,
    SetupData        := "db3300_BC550_Chaves".setup.setupData,
    KwRealV          := "db3302_BC550_SetupPorTensao".setupV.kwReal,
    RmedidoV         := "db3302_BC550_SetupPorTensao".setupV.rMedidoOhm,
    VmedidaV         := "db3302_BC550_SetupPorTensao".setupV.vMedidaV,
    BaseKwV          := "db3302_BC550_SetupPorTensao".setupV.baseKw,
    SetupDataV       := "db3302_BC550_SetupPorTensao".setupV.setupData,
