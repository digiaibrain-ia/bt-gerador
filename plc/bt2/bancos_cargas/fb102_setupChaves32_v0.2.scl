FUNCTION_BLOCK "fb102_setupChaves32"
TITLE = fb102_setupChaves32 (FB102)
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : 'Reginaldo Lobo'
VERSION : 0.2
////====================================
//// fb102_setupChaves32 (FB102)  -  RASCUNHO v0.1 (03/11/2026) - para bancos de 17 a 32 chaves (hoje so o BC59,5). NAO compilado no TIA, NAO testado
//// O QUE FAZ : MESMA LOGICA do fb100_setupChaves v0.3, mas com arrays de ate 32 chaves (era 16).
////             Nasce para o BC59,5 (18 chaves) e BC550 (12 chaves) e para qualquer banco futuro de ate 32
////             chaves, sem retrabalho. O FB100 NAO foi alterado (BC56 e BC400 continuam nele, ja testados).
//// DECISAO   : operador, 03/11/2026 ("melhor criar outro FB para 32 chaves, assim nao gera retrabalho").
//// DIFERENCA : so o tamanho dos arrays (1..16 -> 1..32 e 1..3,1..16 -> 1..3,1..32). Nenhuma regra mudou.
//// INSTANCIAS: db3204_BC595_SetupChaves32 (BC59,5, 18 chaves). Bancos ate 16 chaves (BC56, BC400, BC550) usam o FB100. Chamadas: chamadas_BC595_v0.2.scl.
//// COMO OPERA: igual ao FB100 - arrays por VAR_IN_OUT ligados direto ao DB do banco (db3200/db3300) e ao
////             DB de setup por tensao (db3202/db3302).
//// ATENCAO   : 1) arrays IN_OUT de FB com acesso otimizado: o TIA exige que o tamanho do array ligado seja
////             IGUAL ao declarado (32). Por isso os DBs dos bancos novos tem arrays 1..32 mesmo no BC550 (12).
////             2) BC59,5 e BC550: kW nominal informado pelo operador em 30/10/2026; tensoes 220/380/440 assumidas.
//// v0.2 (03/11/2026, auditoria): (1) NumChaves limitado a 32 (#_n): acima disso o indice saia do array (OB121/STOP);
////             (2) chave DESABILITADA ou de reserva tem CbLigar zerado a cada ciclo (antes so na troca de selecao: desabilitar
////             uma chave ja ligada nao a desligava); (3) Salvar com kW real <= 0,05 grava SetupOk = FALSE e R = 0 (antes gravava
////             SetupOk = TRUE mantendo o R da calibracao anterior). NAO compilado no TIA.
////=====================================
   VAR_INPUT
      NumChaves        : UInt;                  // quantidade real de chaves ATIVAS deste banco (1..32). BC56=13, BC400=13, BC59,5=18, BC550=12.
      GeradorOperando  : Bool;                   // CONFIRMADO: db52_BancoTeste2_DSE.ledManual = TRUE
      EnsaioAtivo      : Bool;                   // PENDENTE: fixo FALSE ate existir o DB "Dados do ensaio" (ver exemplo_chamada_fb100.scl)
      kWMedido         : Real;                   // db52_BancoTeste2_DSE.potenciaKw
      VaMedido         : Real;                   // db52_BancoTeste2_DSE.tensaoL1L2
      VbMedido         : Real;                   // db52_BancoTeste2_DSE.tensaoL2L3
      VcMedido         : Real;                   // db52_BancoTeste2_DSE.tensaoL3L1
      TensaoSel        : Int;                    // NOVO v0.3: db3202/db3302 (e db152/db160) selV.tensaoSel - chaveamento ativo INFORMADO pelo HTML/Node-RED (0 = nao informado, 1 = 220 V, 2 = 380 V, 3 = 440 V)
      ChaveSelecionada : UInt;                   // setup.chaveSel do DB do banco - 1..NumChaves; 0 = nenhuma
      ComandoSalvar    : Bool;                   // setup.salvar do DB do banco - pulso, grava na borda de subida
      kWNominal        : Array[1..32] of Real;   // setup.nominal do DB do banco (v0.3: nao usado nas contas - mantido para nao mudar a chamada)
   END_VAR

   VAR_OUTPUT
      BaseKW : Real;    // "kW sem carga" calculado (media movel) - equivale a BASE do HTML
      BaseOK : Bool;    // true = BaseKW confiavel (ja teve 1a leitura valida desde o ultimo START)
      SalvarRecusado : Bool;  // NOVO v0.3: TRUE se o ultimo pedido de Salvar foi recusado por TensaoSel fora de 1..3 (diagnostico; zera no proximo pedido valido)
   END_VAR

   VAR_IN_OUT
      CbLigar     : Array[1..32] of Bool;   // <db do banco>.cb.ligar - FB100 escreve
      SbLigada    : Array[1..32] of Bool;   // <db do banco>.sb.ligada - FB100 so LE (escrito pelo mapeamento de I/O)
      Habilitada  : Array[1..32] of Bool;   // <db do banco>.setup.habilitada - FB100 so LE (escrito pelo Node-RED/HTML)
      SetupOk     : Array[1..32] of Bool;   // <db do banco>.setup.setupOk - FB100 escreve
      KwReal      : Array[1..32] of Real;   // <db do banco>.setup.kwReal - FB100 escreve
      RmedidoOhm  : Array[1..32] of Real;   // <db do banco>.setup.rMedidoOhm - FB100 escreve
      RteoricoOhm : Array[1..32] of Real;   // <db do banco>.setup.rTeoricoOhm - FB100 escreve
      SetupData   : Array[1..32] of DTL;    // <db do banco>.setup.setupData - FB100 escreve
      // --- NOVO v0.3: valores por chaveamento (db152 BC56 / db160 BC400). 1o indice = chaveamento (1=220, 2=380, 3=440) ---
      KwRealV     : Array[1..3, 1..32] of Real;  // <db152|db160>.setupV.kwReal - FB100 escreve (kW com a chave - base)
      RmedidoV    : Array[1..3, 1..32] of Real;  // <db152|db160>.setupV.rMedidoOhm - FB100 escreve (ohm equivalente em estrela por fase)
      VmedidaV    : Array[1..3, 1..32] of Real;  // <db152|db160>.setupV.vMedidaV - FB100 escreve (tensao media fase-fase no Salvar)
      BaseKwV     : Array[1..3, 1..32] of Real;  // <db152|db160>.setupV.baseKw - FB100 escreve (BaseKW usado no Salvar)
      SetupDataV  : Array[1..3, 1..32] of DTL;   // <db152|db160>.setupV.setupData - FB100 escreve
      SetupOkV    : Array[1..3, 1..32] of Bool;  // <db152|db160>.setupV.setupOk - FB100 escreve
   END_VAR

   VAR
      _geradorOperandoAnt : Bool;   // memoria de borda - detecta START novo do gerador
      _chaveSelAnt         : UInt;  // memoria de borda - detecta troca de chave selecionada
      _cmdSalvarAnt         : Bool; // memoria de borda - detecta clique em "Salvar esta chave"
      _algumaLigada          : Bool; // auxiliar: alguma das NumChaves esta fisicamente ligada agora (SbLigada)
      _vMedio                 : Real; // auxiliar: tensao media das 3 fases no instante do Salvar
      _agora                   : DTL;  // auxiliar: data/hora lida por RD_SYS_T no instante do Salvar
      _retRdSysT                : Int;  // retorno de RD_SYS_T (0 = ok; codigo de erro se <> 0) - ainda nao tratado
      i                        : UInt; // indice de loop
      _n                       : UInt; // v0.2: NumChaves limitado a 32 (indice nunca sai do array)
      _t                       : Int;  // auxiliar v0.3: chaveamento ativo (copia de TensaoSel quando valido)
   END_VAR


BEGIN

   #_n := #NumChaves;
   IF #_n > 32 THEN
      #_n := 32;   // v0.2: protecao de indice
   END_IF;

   REGION "1) kW sem carga" - media movel continua (equivale a BASE/BASE_OK do HTML)

      // ATENCAO (assumido, nao confirmado com o operador): no HTML, BASE_OK so e resetado pelo botao
      // "Desligar gerador" do Demo - nao explicitamente no STOP real do gerador. Aqui assumi que um
      // START novo (borda de subida de GeradorOperando) deve remedir a base do zero. Avisar se nao for
      // o comportamento desejado.
      IF NOT #GeradorOperando AND #_geradorOperandoAnt THEN
         #BaseOK := FALSE;
         #BaseKW := 0.0;
      END_IF;

      #_algumaLigada := FALSE;
      FOR #i := 1 TO #_n DO
         IF #SbLigada[#i] THEN
            #_algumaLigada := TRUE;
         END_IF;
      END_FOR;

      IF #GeradorOperando AND NOT #_algumaLigada THEN
         IF NOT #BaseOK THEN
            #BaseKW := #kWMedido;                        // 1a leitura valida - igual ao HTML (BASE==null -> BASE=MED.kw)
         ELSE
            #BaseKW := #BaseKW * 0.8 + #kWMedido * 0.2;   // media movel exponencial - igual ao HTML (BASE=BASE*0.8+kW*0.2)
         END_IF;
         #BaseOK := TRUE;
      END_IF;

      #_geradorOperandoAnt := #GeradorOperando;

   END_REGION


   REGION "2) Selecao e acionamento da chave (CbLigar)"

      // "Habilitada" decidido como bit logico simples (sem par CB/SB de campo): e so uma permissao de
      // operacao (trava manutencao/defeito), sem contator ou confirmacao fisica propria - decisao do
      // assistente em 20/10/2026, usuario sem objecao. Revisar se no futuro existir uma trava fisica real.

      IF #ChaveSelecionada <> #_chaveSelAnt THEN
         // desliga o comando de todas, religa so a nova selecionada
         FOR #i := 1 TO #_n DO
            #CbLigar[#i] := FALSE;
         END_FOR;

         IF #ChaveSelecionada >= 1 AND #ChaveSelecionada <= #_n THEN
            IF #Habilitada[#ChaveSelecionada] THEN
               #CbLigar[#ChaveSelecionada] := TRUE;
            END_IF;
         END_IF;

         #_chaveSelAnt := #ChaveSelecionada;
      END_IF;

      // trava de seguranca: ensaio em andamento desliga o comando de todas as chaves.
      // v0.2 (21/10/2026): removida a condicao "OR NOT GeradorOperando". O operador confirmou que as chaves
      // podem ser operadas com o gerador desligado (bancada e operacao real). GeradorOperando continua sendo
      // usado so na REGION 1 (kW sem carga) e na validacao do Salvar (BaseOK), onde a medicao exige gerador.
      IF #EnsaioAtivo THEN
         FOR #i := 1 TO #_n DO
            #CbLigar[#i] := FALSE;
         END_FOR;
      END_IF;

      // v0.2: chave DESABILITADA (trava de manutencao) ou de reserva nunca fica comandada, nem se foi desabilitada ja ligada.
      FOR #i := 1 TO 32 DO
         IF #i > #_n OR NOT #Habilitada[#i] THEN
            #CbLigar[#i] := FALSE;
         END_IF;
      END_FOR;

   END_REGION


   REGION "3) Salvar calibracao (borda de subida de ComandoSalvar) - v0.3: por chaveamento"

      IF #ComandoSalvar AND NOT #_cmdSalvarAnt
         AND #ChaveSelecionada >= 1 AND #ChaveSelecionada <= #_n
         AND #BaseOK THEN

         IF #TensaoSel >= 1 AND #TensaoSel <= 3 THEN
            #SalvarRecusado := FALSE;
            #_t := #TensaoSel;
            #_vMedio := (#VaMedido + #VbMedido + #VcMedido) / 3.0;

            #KwRealV[#_t, #ChaveSelecionada] := #kWMedido - #BaseKW;
            #VmedidaV[#_t, #ChaveSelecionada] := #_vMedio;
            #BaseKwV[#_t, #ChaveSelecionada]  := #BaseKW;

            IF #KwRealV[#_t, #ChaveSelecionada] > 0.05 THEN   // mesma trava de ruido do HTML (real>0.05 antes de calcular R)
               // Ohm equivalente em ESTRELA por fase = V_fase-fase^2 / P_total (mesma formula do HTML/v0.2).
               #RmedidoV[#_t, #ChaveSelecionada] := (#_vMedio * #_vMedio) / (#KwRealV[#_t, #ChaveSelecionada] * 1000.0);
            ELSE
               #RmedidoV[#_t, #ChaveSelecionada] := 0.0;   // v0.2: sem kW real mensuravel nao ha R (nao herda a calibracao anterior)
            END_IF;

            // R TEORICO REMOVIDO na v0.3: a formula antiga (V medida^2 / kW nominal) mistura a tensao ao vivo com a
            // potencia de placa, cuja tensao de referencia (V_ref) e DESCONHECIDA. Sera estimada na pratica pelo Setup.

            // RD_SYS_T e uma FUNCAO com parametro de saida OUT (nao devolve DTL como valor).
            #_retRdSysT := RD_SYS_T(OUT => #_agora);       // data/hora do CLP no momento da gravacao
            #SetupDataV[#_t, #ChaveSelecionada] := #_agora;
            #SetupOkV[#_t, #ChaveSelecionada]   := #KwRealV[#_t, #ChaveSelecionada] > 0.05;   // v0.2: so vale com kW real mensuravel
         ELSE
            #SalvarRecusado := TRUE;   // chaveamento nao informado: nao grava nada (evita valor sem tensao de origem)
         END_IF;

      END_IF;

      #_cmdSalvarAnt := #ComandoSalvar;

   END_REGION


   REGION "4) Espelho do chaveamento ativo nos arrays 1D do DB do banco (db150/db158)"

      // Os arrays 1D do DB do banco (o que o Node-RED v2.4 e o HTML leem) passam a mostrar SEMPRE os valores do
      // chaveamento ativo. ASSUMIDO (a confirmar): com TensaoSel = 0 (nao informado) o espelho fica SEM Setup
      // (SetupOk = FALSE), para nunca usar kW real de outra tensao em "Usar kW real nos calculos".
      FOR #i := 1 TO #_n DO
         IF #TensaoSel >= 1 AND #TensaoSel <= 3 THEN
            #SetupOk[#i]      := #SetupOkV[#TensaoSel, #i];
            #KwReal[#i]       := #KwRealV[#TensaoSel, #i];
            #RmedidoOhm[#i]   := #RmedidoV[#TensaoSel, #i];
            #SetupData[#i]    := #SetupDataV[#TensaoSel, #i];
         ELSE
            #SetupOk[#i]      := FALSE;
            #KwReal[#i]       := 0.0;
            #RmedidoOhm[#i]   := 0.0;
         END_IF;
         #RteoricoOhm[#i] := 0.0;   // 0.0 = "nao calculado" (V_ref desconhecida)
      END_FOR;

   END_REGION

END_FUNCTION_BLOCK
