DATA_BLOCK "db150_BC56_Chaves"
TITLE = db150_BC56_Chaves v0.3 (DB150)
{ S7_Optimized_Access := 'FALSE' }
AUTHOR : 'Reginaldo Lobo'
VERSION : 0.3
NON_RETAIN
////====================================
//// db150_BC56_Chaves (DB150)
//// VERSAO    : 0.3 (27/10/2026) - so versao/comentarios; layout IDENTICO ao v0.2 (cbBanco X460.0, sbBanco X462.0/X462.1). Se o DB do PLC ainda NAO tem cbBanco/sbBanco, ESTE e o que precisa ser carregado.
////             (a versao fica AQUI porque o nome do bloco no TIA nao leva versao: o arquivo external source
////              "db150_BC56_Chaves_v0.3" perde o sufixo ao gerar o bloco. Padrao de 27/10/2026.)
//// O QUE FAZ : card "Chaves do banco de carga" - banco BC56 (13 chaves, 56 kW nominal). Habilita/desabilita,
////             aciona (CB) e confirma status (SB) de cada chave, e guarda o Setup (kW real / resistencia)
////             chave a chave. Pode servir BT1 ou BT2 - a associacao banco->BT e feita pelo Node-RED, nao
////             existe campo de BT aqui (ver claude/PLANO_NUMERACAO_BLOCOS_PLC.md, secao 4 "banco nao
////             pertence ao BT").
//// POR QUE DB GLOBAL SEM OTIMIZACAO : o Node-RED (node-red-contrib-s7) grava/le por offset fixo via S7
////             (PUT/GET), por isso o layout e fixo e nao pode ser reordenado.
//// AGRUPAMENTO cb/sb/setup : mesmo padrao do exemplo db20_exemploStruct.db (Reginaldo Lobo, 19/10/2026) -
////             cb = comandos (Control Bit), sb = status/confirmacao de campo (Status Bit), setup = calibracao.
//// ESCRITORES :
////    - cb.ligar[]        : escrito pelo FB100 (fb100_setupChaves), instancia DB154.
////    - sb.ligada[]       : escrito pelo mapeamento de entradas digitais do PLC (fora do escopo do FB100) -
////                          contato auxiliar real de cada chave. FB100 so LE sb.ligada[], nunca escreve.
////    - setup.habilitada[] : escrito pelo Node-RED/HTML (card Chaves, popup Habilitar/desabilitar).
////    - setup.chaveSel/setup.salvar : escrito pelo Node-RED/HTML (popup Setup - selecao e comando "Salvar esta chave").
////    - setup.nominal[] : constante de projeto, pre-carregada abaixo (nao muda em operacao).
////    - setup.setupOk[]/kwReal[]/rMedidoOhm[]/rTeoricoOhm[]/setupData[] : escrito pelo FB100 ao salvar a calibracao.
//// RELACAO COM OUTROS DBs : DB154 e a instancia do FB100 para este banco (1 por banco), memoria de
////             trabalho interna do FB - NAO duplica os arrays deste DB, opera neles por referencia
////             (VAR_IN_OUT). Renomeado de db55_BancoTeste2_Chaves (sufixo 56) conforme
////             claude/PLANO_NUMERACAO_BLOCOS_PLC.md v2 (20/10/2026) - ainda NAO migrado no PLC real,
////             congelado ate apos a janela de teste de quinta/sexta.
//// PENDENCIA : "EnsaioAtivo" (trava do Setup durante o ensaio) depende do DB "Dados do ensaio" (ainda a
////             criar) - por enquanto o FB100 recebe FALSE fixo (ver exemplo_chamada_fb100.scl).
//// v0.2 (24/10/2026): acrescentados NO FIM do DB (offsets antigos intactos, Node-RED v2.3 continua valendo
////             para os campos antigos): cbBanco.ligar (DBX460.0) e sbBanco.seletoraAuto/comEt200Ok
////             (DBX462.0/462.1). Escritores: cbBanco.ligar = Node-RED (POST /api/chaves/{banco}/banco) e
////             FB101 (zera por seguranca); sbBanco.* = FB101 (saidas SeletoraAuto e ComOk).
////             Nao foi possivel usar cb.ligarBanco/sb.seletoraAuto (decisao D3) sem deslocar sb e setup.
////             ATENCAO: o download de DB nao otimizado com membros novos REINICIALIZA o DB (perde
////             habilitada/setupOk/kwReal/rMedidoOhm). Antes: "Snapshot dos valores atuais" e
////             "Aplicar snapshot como valores iniciais" no TIA.
//// Fonte: claude/ESPECIFICACAO_CARD_CHAVES_DB55_FB200.md + claude/PLANO_NUMERACAO_BLOCOS_PLC.md (projeto "NOde-red")
////=====================================
   VAR
      cb : Struct
         ligar : Array[1..16] of Bool;   // comando - aciona o contator/rele de cada chave (13 reais + 3 reserva)
      END_STRUCT;

      sb : Struct
         ligada : Array[1..16] of Bool;  // status - contato auxiliar confirma chave realmente ligada
      END_STRUCT;

      setup : Struct
         habilitada   : Array[1..16] of Bool;  // trava logica (nao e CB/SB de campo) - Node-RED/HTML escreve
         setupOk      : Array[1..16] of Bool;
         kwReal       : Array[1..16] of Real;
         rMedidoOhm   : Array[1..16] of Real;
         rTeoricoOhm  : Array[1..16] of Real;   // aplicada formula de carga resistiva pura (ver fb100), a confirmar na pratica
         setupData    : Array[1..16] of DTL;
         nominal      : Array[1..16] of Real;   // CONFIRMADO - ver valores iniciais no BEGIN
         chaveSel     : UInt;                   // 0 = nenhuma; 1..16 = indice em calibracao
         salvar       : Bool;                   // pulso "Salvar esta chave"
         usarKwReal   : Bool;                   // equivale a USAR_REAL do HTML, por banco
      END_STRUCT;

      cbBanco : Struct   // DBX460.0
         ligar : Bool;   // comando Ligar banco - Node-RED escreve, FB101 zera (seguranca)
      END_STRUCT;

      sbBanco : Struct   // DBX462.0
         seletoraAuto : Bool;   // 462.0 seletora do banco em Auto e ComOk - escrito pelo FB101
         comEt200Ok : Bool;   // 462.1 comunicacao 1515-ET200 viva - escrito pelo FB101 (ComOk)
      END_STRUCT;
   END_VAR


BEGIN
   // kW nominal confirmado em medidor_gerador_v1.9.37.html, const BANCOS (linha ~1618)
   setup.nominal[1]  := 5.0;
   setup.nominal[2]  := 5.0;
   setup.nominal[3]  := 5.0;
   setup.nominal[4]  := 5.0;
   setup.nominal[5]  := 5.0;
   setup.nominal[6]  := 4.0;
   setup.nominal[7]  := 4.0;
   setup.nominal[8]  := 4.0;
   setup.nominal[9]  := 4.0;
   setup.nominal[10] := 4.0;
   setup.nominal[11] := 4.0;
   setup.nominal[12] := 4.0;
   setup.nominal[13] := 3.0;
   // 14..16: reservado, 0.0 (default)

END_DATA_BLOCK
