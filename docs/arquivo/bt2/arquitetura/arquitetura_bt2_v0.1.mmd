graph TD
    %% Configurações Gerais
    classDef default fill:#FFFFFF,stroke:#D1D5DB,stroke-width:1px,rx:8px,ry:8px;
    
    %% --- SEÇÃO 1: OPERAÇÃO ---
    subgraph S1 [ "🌐 OPERAÇÃO (TELA)" ]
        A1["📊 Medidor 1.10.167"]
        A2["📜 Gerenciador de Logs"]
        A3["📈 Gráfico do Ensaio"]
    end
    style S1 fill:#EFF6FF,stroke:#3B82F6,stroke-width:1px,stroke-dasharray: 5 5,rx:12px,ry:12px

    %% --- SEÇÃO 2: PC BT2 ---
    subgraph S2 [ "💻 PC BT2 (.156) - Node-RED" ]
        B_Guarda["🔒 Guarda de Escrita"]
        B1["🎛️ Comando de Chaves"]
        B2["🗃️ Registro do Ensaio"]
        B3["📝 Logs"]
        B4["⚡ Gerador (DSE)"]
    end
    style S2 fill:#F5F3FF,stroke:#8B5CF6,stroke-width:1px,stroke-dasharray: 5 5,rx:12px,ry:12px

    %% --- SEÇÃO 3: PLC 1500 ---
    subgraph S3 [ "⚙️ PLC 1500 DO ENSAIO" ]
        C1["💾 DB3000 / DB3100"]
        C2["💾 DB2000 / DB2100"]
        C3["🧩 FB100 / FB101"]
    end
    style S3 fill:#ECFDF5,stroke:#10B981,stroke-width:1px,stroke-dasharray: 5 5,rx:12px,ry:12px

    %% --- SEÇÃO 4: BANCO PROVISÓRIO ---
    subgraph S4 [ "📦 ET200/1200 - BANCO DE CARGA PROVISÓRIO" ]
        D1["🔋 BC550"]
        D2["🔋 BC595"]
        D3["⏳ Sinais do DSE (Futuro)"]
    end
    style S4 fill:#FFFBEB,stroke:#F59E0B,stroke-width:1px,stroke-dasharray: 5 5,rx:12px,ry:12px

    %% --- SEÇÃO 5: CAMPO ---
    subgraph S5 [ "🏗️ CAMPO" ]
        E1["🏭 Bancos de Carga"]
        E2["⚙️ Gerador (Carga Desacoplada)"]
    end
    style S5 fill:#FEF2F2,stroke:#EF4444,stroke-width:1px,stroke-dasharray: 5 5,rx:12px,ry:12px

    %% --- SEÇÃO 6: FUTURO ---
    subgraph S6 [ "🔮 RESERVADO PARA O FUTURO" ]
        F1["🖥️ Servidor Virtual (.31)"]
        F2["🛢️ SQL Server"]
    end
    style S6 fill:#F9FAFB,stroke:#9CA3AF,stroke-width:1px,stroke-dasharray: 5 5,rx:12px,ry:12px

    %% --- FLUXO DE CONEXÕES (DE CIMA PARA BAIXO) ---
    A1 & A2 & A3 --> B_Guarda
    B_Guarda --> B1 & B2 & B3 & B4
    
    B1 --> C3
    B2 & B3 & B4 --> C1 & C2
    
    C3 --> D1 & D2
    C1 & C2 -.-> D3
    
    D1 & D2 --> E1
    D3 -.-> E2
    
    E1 & E2 -.-> F1
    F1 --> F2

    %% --- ESTILIZAÇÃO DOS NÓS ESPECÍFICOS ---
    %% Destaques centrais/Finais (Roxo e Laranja)
    style B_Guarda fill:#8B5CF6,stroke:#7C3AED,stroke-width:2px,color:#FFFFFF
    style D1 fill:#FFF3CD,stroke:#FFC107
    style D2 fill:#FFF3CD,stroke:#FFC107
    style E1 fill:#FFEDEB,stroke:#F87171
    style E2 fill:#FFEDEB,stroke:#F87171
